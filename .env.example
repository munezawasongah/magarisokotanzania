# alerts, inspection bookings, password-reset codes for email-only accounts.
EMAIL_DRIVER="console"
EMAIL_FROM="MagariSOKO Tanzania <no-reply@magarisoko.co.tz>"
# smtp: any mailbox (cPanel / Google Workspace / Zoho). Port 465 = SSL, 587 = STARTTLS
